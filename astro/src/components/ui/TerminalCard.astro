---
import type { TerminalLine } from '@/data/session';

interface Props { label: string; lines: TerminalLine[] }
const { label, lines } = Astro.props;

const tone: Record<TerminalLine['type'], string> = {
  input: 'text-ink',
  output: 'text-ink/50',
  comment: 'text-ink/35',
  payload: 'text-accent/85'
};
---

<article
  data-anim="term-card"
  class="border border-white/10 bg-[rgba(11,11,16,0.72)] shadow-[0_20px_60px_rgba(0,0,0,0.5)] backdrop-blur-xl"
>
  <header class="flex items-center gap-2.5 border-b border-white/[0.07] px-4 pt-3.5 pb-3">
    <div class="flex gap-[5px]" aria-hidden="true">
      <span class="size-[9px] bg-[#e5484d]"></span>
      <span class="size-[9px] bg-amber"></span>
      <span class="size-[9px] bg-[#5cc98d]"></span>
    </div>
    <h3 class="font-pixel text-[9px] text-ink/45">{label}</h3>
  </header>

  <div class="flex flex-col gap-[3px] px-[18px] pt-[18px] pb-5 font-mono text-[12.5px] leading-[1.75]">
    {lines.map((line) => (
      <p data-term-line data-term-order={line.order} class={tone[line.type]}>
        {line.type === 'input' ? '> ' : ''}{line.text}
      </p>
    ))}
    <p class="text-ink">&gt; <span class="animate-blink">_</span></p>
  </div>
</article>
