---
interface Props { eyebrow: string; class?: string }
const { eyebrow, class: className = '' } = Astro.props;
---

<div data-anim="reveal" class={`max-w-[620px] mb-[clamp(44px,6vh,72px)] ${className}`}>
  <p class="mb-[22px] font-mono text-[11px] uppercase tracking-[0.2em] text-accent/85">{eyebrow}</p>
  <h2 class="m-0 font-pixel text-[clamp(19px,2.5vw,33px)] font-normal leading-[1.4] tracking-normal mb-6">
    <slot name="title" />
  </h2>
  <div class="mt-5 max-w-[560px] text-[clamp(16px,1.5vw,19px)] leading-relaxed text-ink/55">
    <slot />
  </div>
</div>
