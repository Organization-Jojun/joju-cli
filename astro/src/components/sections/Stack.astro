---
import StackBento from '@/components/react/StackBento';
---

<section data-anim="stack" class="relative z-2 bg-[rgba(8,8,11,0.74)] px-6 py-[clamp(90px,13vh,150px)]">
  <div class="mx-auto w-full max-w-[1080px]">
    <div data-anim="reveal" class="mb-[clamp(44px,6vh,72px)] max-w-[620px]">
      <p class="mb-[22px] font-mono text-[11px] uppercase tracking-[0.2em] text-accent/85">Bajo el capó</p>
      <h2 class="m-0 font-pixel text-[clamp(19px,2.5vw,33px)] font-normal leading-[1.4] tracking-normal">
        Código abierto,<br />pieza por pieza.
      </h2>
    </div>

    <StackBento client:visible />
  </div>
</section>
