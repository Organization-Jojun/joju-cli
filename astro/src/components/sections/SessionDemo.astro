---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TerminalCard from '@/components/ui/TerminalCard.astro';
import { pcA, pcB } from '@/data/session';
---

<section data-anim="demo" class="relative z-2 bg-[rgba(8,8,11,0.72)] px-6 py-[clamp(90px,13vh,150px)]">
  <div class="mx-auto w-full max-w-[1080px]">
    <SectionHeading eyebrow="Una sesión real">
      <Fragment slot="title">Connect. Send.<br />Receive.</Fragment>
      Los dos lados escriben el mismo nombre de sala. Después, lo que pegas en una terminal aparece en la otra.
    </SectionHeading>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] items-start gap-[18px]">
      <TerminalCard label="PC A" lines={pcA} />
      <TerminalCard label="PC B" lines={pcB} />
    </div>
  </div>
</section>
